# App
APP_PORT=4000
FRONTEND_URL=http://localhost:5173

# Security (CHANGE THESE IN PRODUCTION)
JWT_ACCESS_SECRET=change-this-jwt-secret-before-production
TOKEN_ENCRYPTION_KEY=change-this-token-key-before-production

# Database
DATABASE_URL=file:data/pandrive.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)

# Google OAuth - Primary (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback

# Google OAuth - Additional projects (optional, for rate limit avoidance)
# Create separate Google Cloud projects with same redirect URI
# Backend will round-robin across all configs
GOOGLE_CLIENT_ID_2=project2-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_2=project2-client-secret
GOOGLE_REDIRECT_URI_2=http://localhost:4000/connected-accounts/google/callback

GOOGLE_CLIENT_ID_3=project3-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_3=project3-client-secret
GOOGLE_REDIRECT_URI_3=http://localhost:4000/connected-accounts/google/callback

# Up to GOOGLE_CLIENT_ID_10 supported

# Optional: Cloudflare Tunnel (auto-runs cloudflared next to the binary)
# TUNNEL_TOKEN=
# Optional: bypass production secret guard for local dev
# APP_ENV=development

# Docker: JWT_ACCESS_SECRET + TOKEN_ENCRYPTION_KEY required via docker-compose environment

# Update checker (GitHub releases API). Defaults to jhopan/pandrive
# UPDATE_REPO=jhopan/pandrive
